# File này quyết định thứ KHÔNG được copy vào image (build context).
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Git
.git
.gitignore
.github

# Secrets — không bao giờ nướng vào image, truyền lúc chạy
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# Không cần lúc chạy
tests/
screenshots/
*.md
grade.py
docker-compose.yml
nginx/
render.yaml

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
